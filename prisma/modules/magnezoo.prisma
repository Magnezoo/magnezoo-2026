enum IconType {
  FILE @map("file")
  URL  @map("url")
}

model Users {
  id        String    @id @db.Uuid
  email     String?   @unique @db.VarChar(255)
  nickname  String    @db.VarChar(30)
  iconPath  String    @map("icon_path") @db.VarChar(255)
  iconType  IconType  @map("icon_type")
  isEnabled Boolean   @default(true) @map("is_enabled")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  posts Posts[]
  votes Vote[]

  @@index([nickname], map: "idx_nickname")
  @@index([isEnabled], map: "idx_enabled")
  @@map("users")
}

model Posts {
  id          String    @id @db.Uuid
  title       String?   @unique @db.VarChar(64)
  description String    @db.VarChar(255)
  imagePath   String    @map("image_path") @db.VarChar(255)
  isDraft     Boolean   @default(true) @map("is_draft")
  userId      String?   @map("user_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user  Users?      @relation(fields: [userId], references: [id])
  tags  TagsPosts[]
  votes Vote[]

  @@index([isDraft], map: "idx_draft")
  @@map("posts")
}

model Tags {
  id   String @id @db.Uuid
  name String @unique @db.VarChar(20)

  posts TagsPosts[]

  @@map("tags")
}

model TagsPosts {
  tagId  String @map("tag_id") @db.Uuid
  postId String @map("post_id") @db.Uuid

  tag  Tags  @relation(fields: [tagId], references: [id])
  post Posts @relation(fields: [postId], references: [id])

  @@id([tagId, postId])
  @@map("tags_posts")
}

model Vote {
  userId String @map("user_id") @db.Uuid
  postId String @map("post_id") @db.Uuid

  user Users @relation(fields: [userId], references: [id])
  post Posts @relation(fields: [postId], references: [id])

  @@id([userId, postId])
  @@map("vote")
}
